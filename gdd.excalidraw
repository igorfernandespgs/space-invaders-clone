      "isDeleted": false,
      "boundElements": [],
      "updated": 1790540066658,
      "created": 1790384037654,
      "link": null,
      "locked": false,
      "text": "Observações:\n- Nenhum dos inimigos colide com a barreira do jogador\n- Respeitam os limites do mapa\n- O jogo fica mais rápido com o tempo\n- O som fica mais rápido com o tempo\n",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Observações:\n- Nenhum dos inimigos colide com a barreira do jogador\n- Respeitam os limites do mapa\n- O jogo fica mais rápido com o tempo\n- O som fica mais rápido com o tempo\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
